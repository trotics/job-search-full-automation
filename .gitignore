# Your personal files never go in git.
my-files/*
!my-files/README.md
reports/*
!reports/README.md
backups/*
!backups/README.md

# Test build output
tests/build/

# Local tool settings (the Skill copy in .claude/skills/ is shared on purpose: Claude Code loads it automatically)
.claude/*
!.claude/skills/
__pycache__/
*.pyc
~$*.xlsx
